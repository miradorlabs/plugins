{
  "name": "@miradorlabs/plugins",
  "version": "1.3.0",
  "packageManager": "pnpm@10.33.0",
  "description": "Mirador SDK plugins for blockchain transaction and Safe multisig tracing",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mirador",
    "tracing",
    "observability",
    "blockchain",
    "web3",
    "evm",
    "safe",
    "solana",
    "relay"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miradorlabs/plugins.git"
  },
  "homepage": "https://github.com/miradorlabs/plugins#readme",
  "bugs": {
    "url": "https://github.com/miradorlabs/plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "husky",
    "build": "rm -rf dist/ && rollup -c",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "pnpm": {
    "overrides": {
      "@jest/transform": "^29.7.0",
      "jest-util": "^29.7.0",
      "jest-haste-map": "^29.7.0",
      "jest-worker": "^29.7.0"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^29.5.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "rollup": "^4.53.3",
    "rollup-plugin-dts": "^6.2.3",
    "ts-jest": "^29.4.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  },
  "author": "@mirador",
  "license": "MIT"
}
